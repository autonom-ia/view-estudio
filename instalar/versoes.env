# View Estudio: versoes fixas de cada programa.
# Formato: CHAVE=VALOR, uma por linha. Linhas com # sao comentario.
# O instalador do Mac e o do Windows leem este arquivo do mesmo jeito (corta no primeiro "=").
# Ao trocar uma versao, troque tambem o SHA256 da mesma linha de baixo, quando houver.

# Node (motor dos comandos). LTS 24. Os SHA256 abaixo foram copiados do SHASUMS256.txt oficial
# (nodejs.org/dist/v24.22.3/SHASUMS256.txt) e ficam gravados aqui: o instalador confere o arquivo
# baixado contra eles, nao contra uma lista baixada do mesmo servidor na hora.
NODE_VERSAO=24.22.3
NODE_SHA256_DARWIN_ARM64=1d64136c8a43d648d1b3bad10797a4c995b1ca032d2bde8799de43b37f058fe5
NODE_SHA256_DARWIN_X64=4daeec962855c1a6e66cda398a25037319dc1bbd4a0939188b3547afbbfb6490
NODE_SHA256_WIN_X64=e612af99f626ab415ea225af6bce5c971feb448cb5cae250bb1c3fa50c5f7d9f
NODE_SHA256_WIN_ARM64=b3cc74a295b39d4f273271e96f58c06dd2b35757ca12abec64c7d0598b434f14

# Navegador escondido (chrome-headless-shell, Chrome for Testing). Mesma versao que o
# hyperframes@0.8.181 pede, para o "cena" e as fotos usarem o mesmo navegador.
# Baixado pelo @puppeteer/browsers que ja vem travado no package-lock (node_modules, puxado pelo
# hyperframes), depois do passo "pacotes": nada e resolvido na hora pelo npx.
# PUPPETEER_BROWSERS_VERSAO e conferida contra node_modules/@puppeteer/browsers/package.json.
CHROME_HEADLESS_SHELL_VERSAO=152.0.7977.30
PUPPETEER_BROWSERS_VERSAO=3.2.7

# FFmpeg (transforma a cena em video). So o "cena" precisa dele.
FFMPEG_VERSAO=8.0.1

# Mac: builds estaticas de martin-riedl.de. O ffprobe fica na mesma pasta, trocando ffmpeg.zip por ffprobe.zip.
FFMPEG_MAC_URL_ARM64=https://ffmpeg.martin-riedl.de/download/macos/arm64/1766430132_8.0.1/ffmpeg.zip
FFMPEG_MAC_SHA256_ARM64=c56f4e2b2ce26a61becf890d8da3415347a1d7d4418cb514915f21612358b790
FFPROBE_MAC_SHA256_ARM64=ad74fb26500f9a67864611856a655636d910b47a21c9ee2f2f7bc7cbaa45bbb2
FFMPEG_MAC_URL_X64=https://ffmpeg.martin-riedl.de/download/macos/amd64/1766437297_8.0.1/ffmpeg.zip
FFMPEG_MAC_SHA256_X64=a6c41c69e829697e408308f1ecd6acdfd0d0a84973ff3a6bf782beba83885ed6
FFPROBE_MAC_SHA256_X64=a09b01e8f54ccdbeb661d48952f412edb858860b38ec7fd1c3901a645e3a3b04

# Windows x64: GyanD/codexffmpeg, release 8.0.1, "essentials". SHA256 = digest oficial do asset no GitHub.
# Reserva (usada so se a principal nao baixar ou vier incompleta): o "full" da mesma release.
FFMPEG_WIN_URL_X64=https://github.com/GyanD/codexffmpeg/releases/download/8.0.1/ffmpeg-8.0.1-essentials_build.zip
FFMPEG_WIN_SHA256_X64=e2aaeaa0fdbc397d4794828086424d4aaa2102cef1fb6874f6ffd29c0b88b673
FFMPEG_WIN_RESERVA_X64=https://github.com/GyanD/codexffmpeg/releases/download/8.0.1/ffmpeg-8.0.1-full_build.zip
FFMPEG_WIN_RESERVA_SHA256_X64=467cde100a47ed4b03a897988aeb4a296890c1e2b2d2864204657d002bc5fb90

# Windows ARM64: BtbN, tag fixa (ramo 8.1). As tags "autobuild" do BtbN somem depois de um tempo;
# por isso a reserva e o ramo 8.1 "latest". A reserva nao tem SHA256 fixo aqui: o instalador baixa o
# checksums.sha256 que o BtbN publica na mesma release e confere por ele. Sem hash, nao instala.
# (Esquema copiado do Estudio de Reels, MIT.)
FFMPEG_WIN_URL_ARM64=https://github.com/BtbN/FFmpeg-Builds/releases/download/autobuild-2026-11-11-12-39/ffmpeg-n8.1.3-35-gf1acb0a266-winarm64-gpl-8.1.zip
FFMPEG_WIN_SHA256_ARM64=2c66859205ac666fa9204cbaf8271e75d65c912e6ca896cf2ee75cb4bf1f4718
FFMPEG_WIN_RESERVA_ARM64=https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-n8.1-latest-winarm64-gpl-8.1.zip
FFMPEG_WIN_RESERVA_SHA256_ARM64=

# Limites.
ESPACO_MINIMO_GB=3
ESPACO_MINIMO_VERIFICAR_GB=1
MEMORIA_MINIMA_GB=8
MAC_MINIMO=13.5
WINDOWS_BUILD_MINIMO=19045

# Atualizacao: endereco do zip da versao mais nova. O "atualizar" so aceita
# https://github.com/autonom-ia/view-estudio/... e exige, ao lado do zip, o arquivo
# view-estudio.zip.sha256 publicado na mesma release (ver comandos-unicos.md, "Publicar uma versao").
ESTUDIO_ATUALIZAR_URL=https://github.com/autonom-ia/view-estudio/releases/latest/download/view-estudio.zip
